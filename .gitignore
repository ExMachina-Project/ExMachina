# Rust
target/
desktop/src-tauri/target/
desktop/src-tauri/target-msvc/
**/*.rs.bk

# Node / WebUI
node_modules/
webui/dist/

# 运行时状态（配置/记忆/数据库/清单）
.exmachina/

# 激活组状态（运行时可变）
agents/active_group
entities/active_group
entities/active_single
# 工作目录（运行时可变）
entities/active_workspace

# 点路径：一律忽略（本机/工具状态目录与文件），需要上传的单独放行
.*
!.gitignore
!.npmrc
!.dockerignore
!.cargo/
!.github/
!.githooks/
!.gitkeep

# 杂项
*.db
*.db-journal
*.db-wal
.DS_Store
agents/dist/

desktop/src-tauri/gen/

# 部署密钥（不入库）
.env
desktop/target
desktop/dist/

# OpenSpec 规划工件（本地规划过程，不入库；specs/ 主规格仍入库）
openspec/changes/

# 私有注册表凭据（docker login 产物，只留在部署目录）
.docker/config.json

# docs 仅允许长期维护的开发指导与设计文档；过程产物不得入库。
/docs/**
!/docs/README.md
!/docs/开发规范.md
!/docs/安装指南.md
!/docs/架构与设计.md
!/docs/协议与契约.md
!/docs/安全模型.md
!/docs/插件开发指南.md
!/docs/元智能体.md
!/docs/客户端兼容身份.md
!/docs/智能体模型分配.md
!/docs/command-directory.md
!/docs/command-entry-matrix.md

# 本地验证产物
/out/
/artifacts/
/test-results/
/playwright-report/
*.tsbuildinfo
